    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "oxlint": "^1.82.0",
    "vite": "^8.2.2",
    "vite-plugin-compression": "^0.5.1"
  }
}

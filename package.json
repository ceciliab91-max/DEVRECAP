{
  "name": "ripasso",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "lint": "oxlint",
    "preview": "vite preview",
    "lighthouse:mobile": "npx lighthouse http://localhost:5173 --preset=mobile --chrome-flags=\"--headless\" --output=html --output-path=./lighthouse-mobile.report.html",
    "lighthouse:desktop": "npx lighthouse http://localhost:5173 --preset=desktop --chrome-flags=\"--headless\" --output=html --output-path=./lighthouse-desktop.report.html",
    "lighthouse:all": "pnpm run lighthouse:mobile && pnpm run lighthouse:desktop"
  },
  "dependencies": {
    "@netlify/blobs": "^11.0.3",
    "@tailwindcss/vite": "^4.3.3",
